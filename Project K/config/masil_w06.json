  "known_conflicts": [
    {"id": "C-01", "docs": ["calculation_definitions.md"], "keywords": ["공헌이익", "쿠폰", "ROAS", "Contribution"],
     "text": "calculation_definitions 1.4 산식은 Coupon Discount·Return Refund를 차감 항목으로 나열하지만, 이 시스템은 GMV가 이미 쿠폰 반영 후이므로 쿠폰·환불을 다시 차감하지 않는다."},
    {"id": "C-02", "docs": ["calculation_definitions.md", "covenant_terms_ms.md"], "keywords": ["전망", "현금", "covenant", "하회", "forecast"],
     "text": "재무팀 공식 전망(fin_cash_forecast_ms)과 원본 정의대로 AR·AP·발주 스케줄을 합산한 재전망은 최소현금 기준 하회 여부가 다를 수 있다. 어느 쪽도 시스템이 정답 처리하지 않는다."},
    {"id": "C-03", "docs": ["lc0001_payment_term_notice.md"], "keywords": ["결제조건", "payment_terms", "통보"],
     "text": "채널 마스터(m_channel_ms)의 결제조건 일수와 결제조건 변경 통보문·AR aging의 만기 기준이 서로 다를 수 있다."}
  ],

  "finance": {
    "covenant_min_krw": 3000000000,
    "horizon_days": 90,
    "sources": ["00_common/calculation_definitions.md §1.2", "02_masil/financials/covenant_terms_ms.md"]
  },

  "approval_rules": {
    "note": "원본 approval_authority_policy.md 그대로. 해외 소규모 실험 집행안에 캠페인 확대안 규정을 준용하는 것은 [교육용 가정] A-009.",
    "single_limit_krw": 10000000,
    "proposal_total_limit_krw": 100000000,
    "within_limit_approver": "mkt_lead",
    "over_limit_approver": "masil_ceo",
    "over_limit_group_report": true,
    "covenant_window_approver": "group_ceo",
    "unconfirmed": [
      "CEO와 이사회 중 누가 먼저 승인하는지(순서)는 원본에 없음 — 확인 필요",
      "공식 전망과 재전망이 충돌할 때 누가 어느 전망을 확정하는지 절차는 원본에 없음 — 확인 필요"
    ]
  },

  "experiment_defaults": {
    "min_orders_per_arm": 100,
    "significance_alpha": 0.05,
    "observation_kind": "합성 관측값(가상 입력)"
  },

  "users": {
    "mkt_staff":  {"name": "마케팅 담당 [교육용 가정]",          "role": "mkt_staff"},
    "mkt_lead":   {"name": "마케팅팀장(전결) [교육용 가정]",      "role": "mkt_lead"},
    "fin_staff":  {"name": "재무 담당 [교육용 가정]",            "role": "fin_staff"},
    "ops_staff":  {"name": "해외 운영 [교육용 가정]",            "role": "ops_staff"},
    "scm_staff":  {"name": "SCM·재고 담당 [교육용 가정]",        "role": "scm_staff"},
    "masil_ceo":  {"name": "대표",                              "role": "masil_ceo"},
    "group_ceo":  {"name": "그룹 CEO",                          "role": "group_ceo"},
    "admin":      {"name": "시스템 관리자 [교육용 가정]",        "role": "admin"}
  },

  "policy": {
    "external_ai_transfer": false,
    "forbidden_actions": ["external.publish", "ad.execute", "payment.execute", "message.send", "data.delete", "source.write", "external_ai.send"],
    "approval_required_actions": ["experiment.start"],
    "auto_actions": [
      "data.read", "rag.search", "metrics.compute", "finance.review", "experiment.draft", "experiment.analyze", "critique.write", "report.write",
      "experiment.submit", "observation.input", "experiment.conclude", "finance.confirm", "finance.scenario", "ops.confirm", "supply.confirm", "approval.decide",
      "policy.edit", "audit.view", "run.start", "attachment.upload", "attachment.view", "attachment.read", "board.archive"
    ],
    "roles": {
      "orchestrator": {"actions": ["data.read", "rag.search", "metrics.compute", "finance.review", "experiment.draft", "experiment.analyze", "critique.write", "report.write", "attachment.read"], "datasets": ["*"], "doc_classes": ["internal", "finance"]},
      "retriever":    {"actions": ["rag.search"], "datasets": [], "doc_classes": ["internal", "finance"]},
      "validator":    {"actions": ["data.read", "metrics.compute"], "datasets": ["orders", "returns", "coupons", "ad_spend", "repurchase", "cost_master", "campaigns", "channels", "assumptions", "preliminary"], "doc_classes": ["internal"]},
      "designer":     {"actions": ["experiment.draft"], "datasets": [], "doc_classes": ["internal"]},
      "analyst":      {"actions": ["experiment.analyze"], "datasets": [], "doc_classes": ["internal"]},
      "finance":      {"actions": ["data.read", "finance.review"], "datasets": ["cash_daily", "cash_forecast", "ar_aging", "ap_aging", "purchase_orders", "budget_plan", "channels", "received_window"], "doc_classes": ["internal", "finance"]},
      "critic":       {"actions": ["critique.write"], "datasets": [], "doc_classes": ["internal"]},
      "reporter":     {"actions": ["report.write"], "datasets": [], "doc_classes": ["internal"]},

      "mkt_staff": {"actions": ["experiment.draft", "experiment.submit", "experiment.start", "observation.input", "experiment.conclude", "run.start", "rag.search", "attachment.upload", "attachment.view"], "datasets": [], "doc_classes": ["internal"]},
      "mkt_lead":  {"actions": ["approval.decide", "run.start", "rag.search", "attachment.upload", "attachment.view"], "datasets": [], "doc_classes": ["internal"]},
      "fin_staff": {"actions": ["finance.confirm", "finance.scenario", "run.start", "rag.search", "attachment.upload", "attachment.view"], "datasets": [], "doc_classes": ["internal", "finance"]},
      "ops_staff": {"actions": ["ops.confirm", "rag.search", "attachment.view"], "datasets": [], "doc_classes": ["internal"]},
      "scm_staff": {"actions": ["supply.confirm", "rag.search", "attachment.view"], "datasets": [], "doc_classes": ["internal"]},
      "masil_ceo": {"actions": ["approval.decide", "run.start", "rag.search", "audit.view", "attachment.upload", "attachment.view"], "datasets": [], "doc_classes": ["internal", "finance"]},
      "group_ceo": {"actions": ["approval.decide", "run.start", "rag.search", "audit.view", "attachment.upload", "attachment.view"], "datasets": [], "doc_classes": ["internal", "finance"]},
      "admin":     {"actions": ["policy.edit", "audit.view", "run.start", "rag.search", "attachment.upload", "attachment.view", "board.archive"], "datasets": [], "doc_classes": ["internal", "finance"]}
    }
  },

  "llm": {"provider": "none", "model": null, "api_key_env": null,
