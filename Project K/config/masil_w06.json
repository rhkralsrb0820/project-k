  "report": {"font_path": "C:/Windows/Fonts/malgun.ttf", "font_bold_path": "C:/Windows/Fonts/malgunbd.ttf", "cycle": "실행 요청 시(주기 보고 미구현)", "audience": ["masil_ceo", "group_ceo"]}
